// spec v0.14.0: nominal (provenance-based) identity — the overflow rule applies only to
// integer-lineage arithmetic; a decimal (incl. whole decimals and / results) never overflows.
// Spec v0.33.0 moved the range to ±9,007,199,254,740,991.
PRINT(2.0 * 9007199254740991)
PRINT((10 / 2) * 9007199254740991)
PRINT(UNWRAP(JSON_PARSE("2.0")) * 9007199254740991)
PRINT(2 + 3.0)
PRINT(SUM(9007199254740991, 9007199254740991.0))
PRINT(TYPE_OF(1.5 + 1.5))
PRINT(3 == 1.5 + 1.5)
